# syntax=docker/dockerfile:1.4
# Reproducible build container for Mosoo RISC0 zkVM guest binary
# Target: riscv32im-risc0-zkvm-elf

FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV RUST_VERSION=1.88.0
ENV CARGO_HOME=/root/.cargo
ENV RUSTUP_HOME=/root/.rustup
ENV PATH="/root/.cargo/bin:/root/.risc0/bin:${PATH}"
ENV SOURCE_DATE_EPOCH=1700000000

ARG GITHUB_TOKEN=""

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    ca-certificates \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install pinned Rust host toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_VERSION}

# Install rzup + RISC0 C++ cross-compiler + RISC0 custom Rust toolchain for riscv32im-risc0-zkvm-elf
RUN curl --proto '=https' --tlsv1.2 -fsSL https://risczero.com/install | bash \
    && if [ -n "${GITHUB_TOKEN}" ]; then export GITHUB_TOKEN="${GITHUB_TOKEN}"; fi \
    && rzup install cpp \
    && rzup install rust

WORKDIR /workspace

# Copy workspace crates required for member resolution
COPY Cargo.toml Cargo.lock ./
COPY mosoo-core/ mosoo-core/
COPY methods/ methods/
COPY daemon/ daemon/
COPY consumers/ consumers/
COPY cli/ cli/

# Build guest binary deterministically with RISC0 guest compiler flags (no nested Docker)
RUN CC_riscv32im_risc0_zkvm_elf=/root/.risc0/cpp/bin/riscv32-unknown-elf-gcc \
    CFLAGS_riscv32im_risc0_zkvm_elf="-march=rv32im -nostdlib" \
    RUSTFLAGS="-C passes=lower-atomic -C link-arg=-Ttext=0x00200800 -C link-arg=--fatal-warnings -C panic=abort" \
    cargo +risc0 build --manifest-path methods/guest/Cargo.toml --release --target riscv32im-risc0-zkvm-elf

# Stage 2: Minimal artifact exporter
FROM alpine:3.19 AS exporter

WORKDIR /out
COPY --from=builder /workspace/target/riscv32im-risc0-zkvm-elf/release/mosoo-guest /out/mosoo-guest

RUN sha256sum /out/mosoo-guest > /out/mosoo-guest.sha256

CMD ["cat", "/out/mosoo-guest.sha256"]
